{
    "version": 3,
    "configurePresets": [
        {
            "name": "linux-release",
            "description": "Linux, Release, the launcher off (see BUILDING-linux.md)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "F117_LAUNCHER": "OFF"
            }
        },
        {
            "name": "linux-debug",
            "description": "Linux, Debug, the launcher off (see BUILDING-linux.md)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "F117_LAUNCHER": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "linux-release",
            "configurePreset": "linux-release"
        },
        {
            "name": "linux-debug",
            "configurePreset": "linux-debug"
        }
    ]
}
